# Leave empty in development: Vite proxies /api to http://localhost:5000.
# In production, set it to the deployed server origin (and add the dashboard's origin to the server's CLIENT_ORIGIN).
VITE_API_URL=

# The public portfolio, used for "View site" links and for images stored as site paths like "/images/...".
VITE_SITE_URL=http://localhost:5173
